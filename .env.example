# Tencent Cloud TokenHub exposes an OpenAI-compatible chat completions API.
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=
# The TokenHub API model identifier is lowercase even though the display name is Hy3.
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=120
# Fallback for unknown/custom stages. Built-in stages use their policy in llm_policy.py.
# Allowed values: no_think, low, medium, high.
HY3_REASONING_EFFORT=low
# Transient Hy3 failures (timeout/network/429/5xx) retry twice with exponential backoff.
HY3_MAX_RETRIES=2
HY3_RETRY_BASE_SECONDS=0.5

# OpenAlex provides a free API key at https://openalex.org/settings/api.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_EMAIL=
OPENALEX_PER_QUERY=30

# General web search. If empty, the Tavily tool is simply not exposed.
ENABLE_OPENALEX=true
ENABLE_TAVILY=true
# Official Tavily fallback.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# Optional Tavily Hub gateway. When this key is set, it takes precedence over
# TAVILY_API_KEY. Create a thb-... key at https://tavily.sharyuke.com/dashboard.
TAVILY_HUB_API_KEY=
TAVILY_HUB_BASE_URL=https://tavily.sharyuke.com/api/proxy
TAVILY_MAX_RESULTS=20
TAVILY_MAX_QUERIES=4
TAVILY_TOPIC=general
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_CONTENT_LENGTH=20000
TAVILY_MAX_SUMMARIZED_RESULTS=5
TAVILY_SUMMARY_CACHE_SIZE=512
TAVILY_SUMMARY_MAX_TOKENS=1200
TAVILY_SUMMARY_TIMEOUT_SECONDS=60

# OpenAlex 全文通过官方 Content API 下载，需要 API Key；每篇内容下载目前会消耗
# OpenAlex Content API 额度。先检索摘要，再由 Researcher 选择最多三篇读取全文。
OPENALEX_FETCH_FULL_TEXT=true
OPENALEX_FULL_TEXT_MAX_DOCUMENTS=3
OPENALEX_FULL_TEXT_MAX_CHARACTERS=50000
OPENALEX_FULL_TEXT_MAX_BYTES=20971520
OPENALEX_FULL_TEXT_TIMEOUT_SECONDS=45

# Dynamic MCP tool loading. Value is a JSON object compatible with
# MultiServerMCPClient, for example:
# MCP_SERVERS={"docs":{"transport":"streamable_http","url":"http://localhost:8001/mcp"}}
MCP_SERVERS={}
MCP_PROMPT=当 MCP 包含公开网页和学术检索无法提供的第一方、私有或专业资料时，优先使用相应工具。

# Parallel Manager/Researcher limits. Some variable names retain the historical
# SUPERVISOR spelling for backward compatibility.
ALLOW_CLARIFICATION=true
REQUIRE_OUTLINE_CONFIRMATION=true
MAX_OUTLINE_REVISIONS=3
MAX_CONCURRENT_RESEARCH_UNITS=5
MAX_SUPERVISOR_ITERATIONS=6
MAX_RESEARCHER_ITERATIONS=10
MAX_SEARCH_TOOL_CALLS=5
# 0 disables the run-wide hard call cap; loop-specific limits still apply.
MAX_HY3_CALLS_PER_RESEARCH=0
RESEARCHER_TOOL_RESULT_MAX_CHARACTERS=20000
RESEARCHER_CONTEXT_MAX_CHARACTERS=60000
COMPRESSION_INPUT_MAX_CHARACTERS=50000
RESEARCH_MEMO_TARGET_CHARACTERS=7000
RESEARCH_MEMO_MAX_CHARACTERS=10000
FINAL_REPORT_CONTEXT_MAX_CHARACTERS=120000
RESEARCH_BRIEF_MAX_TOKENS=1600
SUPERVISOR_MAX_TOKENS=6000
RESEARCHER_MAX_TOKENS=3000
COMPRESSION_MAX_TOKENS=12000
FINAL_REPORT_MAX_TOKENS=16000

# Optional LangSmith tracing and evaluation.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Offline report-quality judge. The script sends one request per completed
# report and records all eight dimensions in the same LangSmith experiment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EVALUATION_JUDGE_MODEL=deepseek-v4-flash
EVALUATION_JUDGE_MAX_TOKENS=1500
EVALUATION_JUDGE_TIMEOUT_SECONDS=120
EVALUATION_JUDGE_MAX_RETRIES=2

# The application stores conversations, memories, and large artifacts here.
# Local LangGraph development works without PostgreSQL; production can switch
# this to postgresql+psycopg://deep_research_assistant:deep_research_assistant_local_only@localhost:5432/deep_research_assistant.
DATABASE_URL=sqlite:///data/deep_research_assistant.db

# Optional local PostgreSQL container settings used by docker-compose.yml.
# The container port is bound to 127.0.0.1 and is intended for development only.
POSTGRES_DB=deep_research_assistant
POSTGRES_USER=deep_research_assistant
POSTGRES_PASSWORD=deep_research_assistant_local_only

# The Web UI creates Threads/Runs on LangGraph Server instead of using Redis/RQ.
LANGGRAPH_API_URL=http://127.0.0.1:2024
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=deep_research_assistant
LANGGRAPH_REQUEST_TIMEOUT_SECONDS=30
